{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@ts-agent/core": ["packages/core/src/index.ts"],
      "@ts-agent/core/*": ["packages/core/src/*"],
      "@ts-agent/core/test/*": ["packages/core/src/test/*"],
      "@ts-agent/cli": ["packages/cli/src/main.ts"],
      "@ts-agent/cli/*": ["packages/cli/src/*"]
    }
  }
}

