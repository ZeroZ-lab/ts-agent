
# Environment Variables

# OpenAI API Key (Required if using OpenAI models)
OPENAI_API_KEY=""

# Optional: Model + endpoint selection
# OPENAI_MODEL="gpt-4.1"
#
# Optional: OpenAI-compatible base URL (scheme+host, or include provider path if needed)
# OPENAI_BASE_URL="https://api.openai.com"
#
# Optional: API base path prefix (defaults to /v1)
# OPENAI_API_PATH="/v1"
#
# Optional: Which OpenAI-compatible API to call
# - "responses" (default): POST {baseUrl}{apiPath}/responses
# - "chat_completions": POST {baseUrl}{apiPath}/chat/completions
# OPENAI_API="responses"
